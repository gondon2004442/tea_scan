# Points the static app at the AI proxy (Cloudflare Worker).
# This IS exposed to the browser (EXPO_PUBLIC_) — it's only a URL, never a key.
# Local dev with `wrangler dev`:   http://localhost:8787
# Production (after deploy):       https://tea-scan-ai.<your-subdomain>.workers.dev
EXPO_PUBLIC_CHAT_API_URL=http://localhost:8787

# NOTE: the Anthropic API key does NOT live here. It is a Cloudflare Worker
# secret (set once with `npx wrangler secret put ANTHROPIC_API_KEY` in /worker).
