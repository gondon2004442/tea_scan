# Server-only — used by the Expo Router API routes (app/api/*+api.ts).
# Never expose this to the client (do NOT prefix with EXPO_PUBLIC_).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: point the client at a separately-hosted proxy.
# Leave empty to use the built-in /api routes on the same origin.
EXPO_PUBLIC_CHAT_API_URL=
